def eh_primo(num):
    if num < 2:
        return False
    
    # Verifica se o número é divisível por algum valor de 2 até a sua raiz quadrada
    for i in range(2, int(num**0.5) + 1):
        if num % i == 0:
            return False
    return True

quantidade_primos = 0

# Recebe 10 números inteiros
for i in range(1, 11):
    numero = int(input(f"Digite o {i}º número inteiro: "))
    if eh_primo(numero):
        quantidade_primos += 1

print(f"\nQuantidade de números primos digitados: {quantidade_primos}")
